# Copy this file to .env and fill in your values.
# .env is gitignored — never commit your actual token.

# Required: get your token from https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=your_mapbox_token_here

# Required for account registration — confirmation emails are sent via Resend
# (https://resend.com). The "from" address (travelmap@luyens.be in server/auth.cjs)
# must be on a domain verified in your Resend account.
RESEND_API_KEY=re_your_resend_api_key

# Required in production — used to build the confirmation-email link
# (defaults to http://localhost:PORT, which is wrong once deployed).
APP_URL=https://travelmap.luyens.be

# Optional: your custom Mapbox style slug (defaults to mapbox/light-v11 if omitted)
# Format: "username/styleId" — find yours at account.mapbox.com/styles
MAPBOX_STYLE=username/styleId

# Optional: port for the upload/render server (default: 3002)
PORT=3002

# Optional: a new user's first session starts from this account's preset named
# START_PRESET_NAME (default "Start"). If START_PRESET_OWNER is not set, the
# oldest verified account is used (normally the owner, who registered first).
# START_PRESET_OWNER=you@example.com
# START_PRESET_NAME=Start

# ── Removed 2026-09-26 ──────────────────────────────────────────────────────
# APP_USERNAME / APP_PASSWORD no longer apply — login is now email + password
# per account, self-registered via the app itself (see README's Authentication
# section). Accounts live in server/data/users.json (gitignored).
